{
  "name": "selection-translate",
  "version": "0.1.0",
  "description": "Translate selected text in notes and PDFs with an inline popup showing pronunciation, part of speech, and alternative meanings.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "Thi Duong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonthicse/obsidian-selection-translate.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "version": "node version-bump.mjs && git add manifest.json versions.json package.json",
    "check": "node scripts/check-guidelines.mjs",
    "verify": "npm run build && npm test && npm run lint && npm run check"
  },
  "keywords": [
    "obsidian-plugin",
    "obsidian-md",
    "translation",
    "deepl",
    "google-translate"
  ],
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {}
}
